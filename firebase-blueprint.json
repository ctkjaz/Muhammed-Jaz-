{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated learner profile, study preferences, single-device session lock, and active exam track synced across devices. Clients must write FieldValue.serverTimestamp() for createdAt and updatedAt.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Firebase Auth UID of the profile owner."
        },
        "email": {
          "type": "string",
          "description": "Optional Google account email for owner admin lookup (max 120 chars)."
        },
        "lastDeviceHash": {
          "type": "string",
          "description": "Optional SHA-256 hex digest of device ANDROID_ID for support lookup (max 64 chars)."
        },
        "displayName": {
          "type": "string",
          "description": "Learner display name (max 40 chars)."
        },
        "role": {
          "type": "string",
          "description": "Qualification or clinical role (max 40 chars)."
        },
        "targetYear": {
          "type": "string",
          "description": "Target exam year (max 10 chars)."
        },
        "focusSubject": {
          "type": "string",
          "description": "Primary focus subject code or empty string for all subjects."
        },
        "activeExamId": {
          "type": "string",
          "description": "Active exam track ID (e.g. rrb_nursing, aiims_norcet, or pgimer_nursing)."
        },
        "themePreference": {
          "type": "string",
          "enum": ["LIGHT", "DARK", "SYSTEM"],
          "description": "Appearance theme preference."
        },
        "negativeMarking": {
          "type": "boolean",
          "description": "Whether negative marking is enabled in practice."
        },
        "useTimeLimit": {
          "type": "boolean",
          "description": "Whether practice countdown timers are enabled."
        },
        "secondsPerQuestion": {
          "type": "integer",
          "description": "Default pacing seconds per question (20 to 120)."
        },
        "keepScreenOn": {
          "type": "boolean",
          "description": "Whether to keep screen awake during active sessions."
        },
        "onboardingCompleted": {
          "type": "boolean",
          "description": "Optional flag indicating whether the learner finished or skipped onboarding."
        },
        "dailyGoalQuestions": {
          "type": "integer",
          "description": "Optional daily MCQ study goal target (5 to 200)."
        },
        "currentStreakDays": {
          "type": "integer",
          "description": "Optional active consecutive-day goal streak counter."
        },
        "longestStreakDays": {
          "type": "integer",
          "description": "Optional best-ever consecutive-day goal streak counter."
        },
        "lastGoalMetDate": {
          "type": "string",
          "description": "Optional YYYY-MM-DD date string when the daily goal was last met."
        },
        "todayStudyDate": {
          "type": "string",
          "description": "Optional YYYY-MM-DD date string for todayAnsweredCount."
        },
        "todayAnsweredCount": {
          "type": "integer",
          "description": "Optional number of questions answered on todayStudyDate."
        },
        "phoneNumber": {
          "type": "string",
          "description": "Optional learner mobile number for profile contact (max 20 chars)."
        },
        "activeSessionId": {
          "type": "string",
          "description": "Optional active single-device session UUID (max 64 chars)."
        },
        "activeDeviceName": {
          "type": "string",
          "description": "Optional display label of the currently active device (max 64 chars)."
        },
        "sessionUpdatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Optional server timestamp when the active device session was last claimed."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp (FieldValue.serverTimestamp())."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server last update timestamp (FieldValue.serverTimestamp())."
        }
      },
      "required": [
        "userId",
        "displayName",
        "role",
        "targetYear",
        "focusSubject",
        "activeExamId",
        "themePreference",
        "negativeMarking",
        "useTimeLimit",
        "secondsPerQuestion",
        "keepScreenOn",
        "createdAt",
        "updatedAt"
      ]
    },
    "QuestionProgressRecord": {
      "title": "QuestionProgressRecord",
      "description": "Per-question mastery, attempt counts, and bookmark state for a user. Clients must write FieldValue.serverTimestamp() for createdAt and updatedAt.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "questionId": { "type": "string" },
        "bookmarked": { "type": "boolean" },
        "attemptsCount": { "type": "integer" },
        "correctCount": { "type": "integer" },
        "wrongCount": { "type": "integer" },
        "lastOutcome": { "type": "string", "enum": ["right", "wrong"] },
        "clientUpdatedAtMs": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "userId",
        "questionId",
        "bookmarked",
        "attemptsCount",
        "correctCount",
        "wrongCount",
        "clientUpdatedAtMs",
        "createdAt",
        "updatedAt"
      ]
    },
    "MockHistoryRecord": {
      "title": "MockHistoryRecord",
      "description": "Completed CBT mock examination score history entry. Clients must write FieldValue.serverTimestamp() for createdAt and updatedAt.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "examId": { "type": "string" },
        "totalQuestions": { "type": "integer" },
        "correctCount": { "type": "integer" },
        "wrongCount": { "type": "integer" },
        "skippedCount": { "type": "integer" },
        "netScore": { "type": "number" },
        "accuracyPercent": { "type": "integer" },
        "completedAtMs": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "userId",
        "title",
        "examId",
        "totalQuestions",
        "correctCount",
        "wrongCount",
        "skippedCount",
        "netScore",
        "accuracyPercent",
        "completedAtMs",
        "createdAt",
        "updatedAt"
      ]
    },
    "CustomQuestionRecord": {
      "title": "CustomQuestionRecord",
      "description": "User-imported custom MCQ synced across devices. Clients must write FieldValue.serverTimestamp() for createdAt and updatedAt.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "category": { "type": "string" },
        "shiftYear": { "type": "string" },
        "subject": { "type": "string" },
        "difficulty": { "type": "string", "enum": ["Easy", "Medium", "Hard"] },
        "questionText": { "type": "string" },
        "options": { "type": "array" },
        "correctIndex": { "type": "integer" },
        "explanation": { "type": "string" },
        "sourceStatus": { "type": "string", "enum": ["verified", "unverified"] },
        "sourceNote": { "type": "string" },
        "topicId": { "type": "string" },
        "sourceType": { "type": "string" },
        "examYear": { "type": "string" },
        "examShift": { "type": "string" },
        "examIds": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "userId",
        "category",
        "shiftYear",
        "subject",
        "difficulty",
        "questionText",
        "options",
        "correctIndex",
        "explanation",
        "sourceStatus",
        "sourceNote",
        "topicId",
        "sourceType",
        "examYear",
        "examShift",
        "examIds",
        "createdAt",
        "updatedAt"
      ]
    },
    "SubscriptionConfig": {
      "title": "SubscriptionConfig",
      "description": "Owner-editable INR pricing table, free tier daily quota, trial duration, support contact info, and OTA catalog version.",
      "type": "object",
      "properties": {
        "singleExam1M": { "type": "integer" },
        "singleExam3M": { "type": "integer" },
        "singleExam6M": { "type": "integer" },
        "singleExam1Y": { "type": "integer" },
        "allExam1M": { "type": "integer" },
        "allExam3M": { "type": "integer" },
        "allExam6M": { "type": "integer" },
        "allExam1Y": { "type": "integer" },
        "freeDailyQuestionLimit": { "type": "integer" },
        "trialDays": { "type": "integer" },
        "supportWhatsAppNumber": { "type": "string" },
        "supportEmail": { "type": "string" },
        "upiId": { "type": "string", "description": "Optional merchant/owner UPI VPA for direct student payments (max 80 chars)." },
        "upiPayeeName": { "type": "string", "description": "Optional UPI payee display name (max 80 chars)." },
        "catalogVersion": { "type": "integer" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "singleExam1M",
        "singleExam3M",
        "singleExam6M",
        "singleExam1Y",
        "allExam1M",
        "allExam3M",
        "allExam6M",
        "allExam1Y",
        "freeDailyQuestionLimit",
        "trialDays",
        "supportWhatsAppNumber",
        "supportEmail",
        "catalogVersion",
        "updatedAt"
      ]
    },
    "UserEntitlement": {
      "title": "UserEntitlement",
      "description": "Tamper-protected subscription and 3-day trial entitlement record for a user. Non-admin writes are permitted only via verified atomic transactions (free bootstrap, 3-day trial + device lock, or single-use access code redemption).",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "planTier": { "type": "string", "enum": ["free", "trial", "single_exam", "all_exam"] },
        "unlockedExamIds": { "type": "array" },
        "status": { "type": "string", "enum": ["active", "suspended", "expired"] },
        "startsAt": { "type": "string", "format": "date-time" },
        "expiresAt": { "type": "string", "format": "date-time" },
        "trialUsed": { "type": "boolean" },
        "trialDeviceHash": { "type": "string" },
        "lastCodeId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "userId",
        "email",
        "displayName",
        "planTier",
        "unlockedExamIds",
        "status",
        "trialUsed",
        "trialDeviceHash",
        "lastCodeId",
        "createdAt",
        "updatedAt"
      ]
    },
    "AccessCode": {
      "title": "AccessCode",
      "description": "Single-use post-payment access voucher generated by the owner admin and redeemed atomically by a learner.",
      "type": "object",
      "properties": {
        "code": { "type": "string" },
        "planTier": { "type": "string", "enum": ["single_exam", "all_exam"] },
        "unlockedExamIds": { "type": "array" },
        "tenureDays": { "type": "integer" },
        "status": { "type": "string", "enum": ["active", "redeemed", "revoked"] },
        "buyerNote": { "type": "string" },
        "createdByEmail": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "redeemedByUid": { "type": "string" },
        "redeemedByEmail": { "type": "string" },
        "redeemedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "code",
        "planTier",
        "unlockedExamIds",
        "tenureDays",
        "status",
        "buyerNote",
        "createdByEmail",
        "createdAt"
      ]
    },
    "DeviceTrialLock": {
      "title": "DeviceTrialLock",
      "description": "One-time physical device trial lock keyed by SHA-256 hash of ANDROID_ID (no raw PII stored; admin can delete to reset lock).",
      "type": "object",
      "properties": {
        "deviceHash": { "type": "string" },
        "shortDeviceCode": { "type": "string" },
        "ownerUid": { "type": "string" },
        "maskedEmail": { "type": "string" },
        "deviceName": { "type": "string" },
        "claimedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "deviceHash",
        "shortDeviceCode",
        "ownerUid",
        "maskedEmail",
        "deviceName",
        "claimedAt"
      ]
    },
    "QuestionPack": {
      "title": "QuestionPack",
      "description": "Admin-published over-the-air question pack metadata synced into student local Room storage.",
      "type": "object",
      "properties": {
        "packId": { "type": "string" },
        "title": { "type": "string" },
        "examId": { "type": "string" },
        "stage": { "type": "string", "enum": ["all", "prelims", "mains"] },
        "subject": { "type": "string" },
        "questionCount": { "type": "integer" },
        "isPremiumOnly": { "type": "boolean" },
        "status": { "type": "string", "enum": ["draft", "published"] },
        "version": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "packId",
        "title",
        "examId",
        "stage",
        "subject",
        "questionCount",
        "isPremiumOnly",
        "status",
        "version",
        "createdAt",
        "updatedAt"
      ]
    },
    "PackQuestion": {
      "title": "PackQuestion",
      "description": "Individual MCQ inside an admin-published OTA question pack.",
      "type": "object",
      "properties": {
        "packId": { "type": "string" },
        "packStatus": { "type": "string", "enum": ["draft", "published"] },
        "examId": { "type": "string" },
        "category": { "type": "string" },
        "shiftYear": { "type": "string" },
        "subject": { "type": "string" },
        "difficulty": { "type": "string", "enum": ["Easy", "Medium", "Hard"] },
        "questionText": { "type": "string" },
        "options": { "type": "array" },
        "correctIndex": { "type": "integer" },
        "explanation": { "type": "string" },
        "sourceStatus": { "type": "string", "enum": ["verified", "unverified"] },
        "sourceNote": { "type": "string" },
        "topicId": { "type": "string" },
        "sourceType": { "type": "string" },
        "examYear": { "type": "string" },
        "examShift": { "type": "string" },
        "sortOrder": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "packId",
        "packStatus",
        "examId",
        "category",
        "shiftYear",
        "subject",
        "difficulty",
        "questionText",
        "options",
        "correctIndex",
        "explanation",
        "sourceStatus",
        "sourceNote",
        "topicId",
        "sourceType",
        "examYear",
        "examShift",
        "sortOrder",
        "createdAt"
      ]
    },
    "ClockSyncPing": {
      "title": "ClockSyncPing",
      "description": "Lightweight per-user server timestamp anchor preventing client clock rollback.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "serverTime": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "serverTime"]
    },
    "DoubtThread": {
      "title": "DoubtThread",
      "description": "Student clinical or exam doubt submitted from a specific MCQ or general study desk, answered by ClinEdge owner faculty.",
      "type": "object",
      "properties": {
        "doubtId": { "type": "string" },
        "userId": { "type": "string" },
        "studentName": { "type": "string" },
        "studentEmail": { "type": "string" },
        "examId": { "type": "string" },
        "subject": { "type": "string" },
        "questionId": { "type": "string" },
        "questionPreview": { "type": "string" },
        "doubtText": { "type": "string" },
        "status": { "type": "string", "enum": ["open", "answered", "closed"] },
        "adminReply": { "type": "string" },
        "repliedBy": { "type": "string" },
        "repliedAt": { "type": "string", "format": "date-time" },
        "studentReadReply": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "doubtId",
        "userId",
        "studentName",
        "studentEmail",
        "examId",
        "subject",
        "questionId",
        "questionPreview",
        "doubtText",
        "status",
        "adminReply",
        "repliedBy",
        "studentReadReply",
        "createdAt",
        "updatedAt"
      ]
    },
    "ExamAnnouncement": {
      "title": "ExamAnnouncement",
      "description": "Owner-admin pushed live notification for Indian nursing exam alerts, vacancies, news, study tips, and app updates.",
      "type": "object",
      "properties": {
        "announcementId": { "type": "string" },
        "title": { "type": "string" },
        "body": { "type": "string" },
        "category": { "type": "string", "enum": ["exam_alert", "vacancy", "news", "study_tip", "app_update"] },
        "targetExamId": { "type": "string" },
        "priority": { "type": "string", "enum": ["normal", "urgent"] },
        "actionUrl": { "type": "string" },
        "createdByEmail": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "announcementId",
        "title",
        "body",
        "category",
        "targetExamId",
        "priority",
        "actionUrl",
        "createdByEmail",
        "createdAt"
      ]
    },
    "DirectNotification": {
      "title": "DirectNotification",
      "description": "Owner-admin pushed individual or custom notification or automatic doubt-reply alert stored privately under a specific student's notifications subcollection.",
      "type": "object",
      "properties": {
        "notificationId": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "body": { "type": "string" },
        "type": { "type": "string", "enum": ["custom_admin", "doubt_reply", "account_notice"] },
        "referenceId": { "type": "string" },
        "actionUrl": { "type": "string" },
        "read": { "type": "boolean" },
        "createdByEmail": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "notificationId",
        "userId",
        "title",
        "body",
        "type",
        "referenceId",
        "actionUrl",
        "read",
        "createdByEmail",
        "createdAt"
      ]
    },
    "PaymentRequest": {
      "title": "PaymentRequest",
      "description": "Student-submitted UPI UTR payment verification request reviewed and approved/rejected by the Owner Admin.",
      "type": "object",
      "properties": {
        "requestId": { "type": "string" },
        "userId": { "type": "string" },
        "studentName": { "type": "string" },
        "studentEmail": { "type": "string" },
        "planTier": { "type": "string", "enum": ["single_exam", "all_exam"] },
        "unlockedExamIds": { "type": "array" },
        "tenureDays": { "type": "integer" },
        "amountInr": { "type": "integer" },
        "utrNumber": { "type": "string" },
        "payerName": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "adminNote": { "type": "string" },
        "reviewedByEmail": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "requestId",
        "userId",
        "studentName",
        "studentEmail",
        "planTier",
        "unlockedExamIds",
        "tenureDays",
        "amountInr",
        "utrNumber",
        "payerName",
        "status",
        "adminNote",
        "reviewedByEmail",
        "createdAt",
        "updatedAt"
      ]
    },
    "QuestionReport": {
      "title": "QuestionReport",
      "description": "Student-flagged MCQ error report (wrong key, typo, outdated guideline, wrong mapping) queued for Owner Admin review.",
      "type": "object",
      "properties": {
        "reportId": { "type": "string" },
        "userId": { "type": "string" },
        "studentName": { "type": "string" },
        "studentEmail": { "type": "string" },
        "examId": { "type": "string" },
        "subject": { "type": "string" },
        "questionId": { "type": "string" },
        "questionPreview": { "type": "string" },
        "reason": { "type": "string", "enum": ["wrong_key", "typo", "outdated", "wrong_mapping", "other"] },
        "note": { "type": "string" },
        "status": { "type": "string", "enum": ["open", "resolved", "dismissed"] },
        "adminResolutionNote": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "reportId",
        "userId",
        "studentName",
        "studentEmail",
        "examId",
        "subject",
        "questionId",
        "questionPreview",
        "reason",
        "note",
        "status",
        "adminResolutionNote",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Owner-isolated learner profile and preferences (readable by verified owner admin)."
    },
    "/users/{userId}/progress/{questionId}": {
      "schema": { "$ref": "#/entities/QuestionProgressRecord" },
      "description": "Owner-isolated question attempt counts, last outcome, and bookmarks."
    },
    "/users/{userId}/mockHistory/{mockId}": {
      "schema": { "$ref": "#/entities/MockHistoryRecord" },
      "description": "Owner-isolated completed CBT mock test history records."
    },
    "/users/{userId}/customQuestions/{questionId}": {
      "schema": { "$ref": "#/entities/CustomQuestionRecord" },
      "description": "Owner-isolated user-imported custom MCQs."
    },
    "/users/{userId}/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/DirectNotification" },
      "description": "Owner-isolated individual admin push notifications and doubt-reply alerts."
    },
    "/appConfig/{configId}": {
      "schema": { "$ref": "#/entities/SubscriptionConfig" },
      "description": "Global subscription pricing, support contacts, and OTA catalog version config."
    },
    "/entitlements/{userId}": {
      "schema": { "$ref": "#/entities/UserEntitlement" },
      "description": "Tamper-protected subscription and 3-day free trial entitlement state."
    },
    "/accessCodes/{codeId}": {
      "schema": { "$ref": "#/entities/AccessCode" },
      "description": "Single-use post-payment access codes created by admin and atomically redeemed by learners."
    },
    "/deviceTrialLocks/{deviceHash}": {
      "schema": { "$ref": "#/entities/DeviceTrialLock" },
      "description": "Hashed ANDROID_ID device trial lock preventing multi-account trial abuse."
    },
    "/questionPacks/{packId}": {
      "schema": { "$ref": "#/entities/QuestionPack" },
      "description": "Admin-published over-the-air question pack catalog."
    },
    "/questionPacks/{packId}/questions/{questionId}": {
      "schema": { "$ref": "#/entities/PackQuestion" },
      "description": "Questions belonging to an admin-published OTA question pack."
    },
    "/clockSync/{userId}": {
      "schema": { "$ref": "#/entities/ClockSyncPing" },
      "description": "Owner-only server timestamp anchor for tamper-resistant expiry checks."
    },
    "/doubts/{doubtId}": {
      "schema": { "$ref": "#/entities/DoubtThread" },
      "description": "Student-owned doubts readable and answerable by the verified owner admin."
    },
    "/announcements/{announcementId}": {
      "schema": { "$ref": "#/entities/ExamAnnouncement" },
      "description": "Owner-admin broadcast feed for nursing exam news, vacancies, dates, and live push alerts."
    },
    "/paymentRequests/{requestId}": {
      "schema": { "$ref": "#/entities/PaymentRequest" },
      "description": "Student UPI UTR payment verification requests reviewed and approved by the Owner Admin."
    },
    "/questionReports/{reportId}": {
      "schema": { "$ref": "#/entities/QuestionReport" },
      "description": "Student-flagged MCQ error reports reviewed and resolved by the Owner Admin."
    }
  }
