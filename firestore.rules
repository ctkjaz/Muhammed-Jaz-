rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Pillar 0: Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Global hardened primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() &&
             request.auth.token.email == 'jazsaleem2004@gmail.com' &&
             request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidTimestamp(ts) {
      return ts is timestamp && ts <= request.time;
    }

    // ------------------------------------------------------------------------
    // VALIDATION HELPERS (Anti-Update-Gap Blueprints)
    // ------------------------------------------------------------------------

    // 1. UserProfile
    function isValidUserProfile(data, userId) {
      return data.userId is string &&
             data.userId == userId &&
             (isAdmin() || data.userId == request.auth.uid) &&
             (!('email' in data) || (data.email is string && data.email.size() <= 120)) &&
             (!('lastDeviceHash' in data) || (data.lastDeviceHash is string && data.lastDeviceHash.size() <= 64)) &&
             data.displayName is string && data.displayName.size() <= 40 &&
             data.role is string && data.role.size() <= 40 &&
             data.targetYear is string && data.targetYear.size() <= 10 &&
             data.focusSubject is string && data.focusSubject.size() <= 32 &&
             data.activeExamId is string && data.activeExamId.size() >= 1 && data.activeExamId.size() <= 64 &&
             data.themePreference is string && data.themePreference in ['LIGHT', 'DARK', 'SYSTEM'] &&
             data.negativeMarking is bool &&
             data.useTimeLimit is bool &&
             data.secondsPerQuestion is int && data.secondsPerQuestion >= 20 && data.secondsPerQuestion <= 120 &&
             data.keepScreenOn is bool &&
             (!('onboardingCompleted' in data) || data.onboardingCompleted is bool) &&
             (!('dailyGoalQuestions' in data) || (data.dailyGoalQuestions is int && data.dailyGoalQuestions >= 5 && data.dailyGoalQuestions <= 200)) &&
             (!('currentStreakDays' in data) || (data.currentStreakDays is int && data.currentStreakDays >= 0 && data.currentStreakDays <= 10000)) &&
             (!('longestStreakDays' in data) || (data.longestStreakDays is int && data.longestStreakDays >= 0 && data.longestStreakDays <= 10000)) &&
             (!('lastGoalMetDate' in data) || (data.lastGoalMetDate is string && data.lastGoalMetDate.size() <= 16)) &&
             (!('todayStudyDate' in data) || (data.todayStudyDate is string && data.todayStudyDate.size() <= 16)) &&
             (!('todayAnsweredCount' in data) || (data.todayAnsweredCount is int && data.todayAnsweredCount >= 0 && data.todayAnsweredCount <= 10000)) &&
             (!('totalXp' in data) || (data.totalXp is int && data.totalXp >= 0 && data.totalXp <= 10000000)) &&
             (!('weeklyXp' in data) || (data.weeklyXp is int && data.weeklyXp >= 0 && data.weeklyXp <= 100000)) &&
             (!('weeklyKey' in data) || (data.weeklyKey is string && data.weeklyKey.size() <= 16)) &&
             (!('weeklyQuestions' in data) || (data.weeklyQuestions is int && data.weeklyQuestions >= 0 && data.weeklyQuestions <= 10000)) &&
             (!('weeklyCorrect' in data) || (data.weeklyCorrect is int && data.weeklyCorrect >= 0 && data.weeklyCorrect <= 10000)) &&
             (!('weeklySessions' in data) || (data.weeklySessions is int && data.weeklySessions >= 0 && data.weeklySessions <= 1000)) &&
             (!('weeklyClaimedIds' in data) || (data.weeklyClaimedIds is list && data.weeklyClaimedIds.size() <= 10 && (data.weeklyClaimedIds.size() == 0 || data.weeklyClaimedIds[0] is string))) &&
             (!('unlockedBadgeIds' in data) || (data.unlockedBadgeIds is list && data.unlockedBadgeIds.size() <= 32 && (data.unlockedBadgeIds.size() == 0 || data.unlockedBadgeIds[0] is string))) &&
             (!('streakShields' in data) || (data.streakShields is int && data.streakShields >= 0 && data.streakShields <= 2)) &&
             (!('lastShieldEarnedStreak' in data) || (data.lastShieldEarnedStreak is int && data.lastShieldEarnedStreak >= 0 && data.lastShieldEarnedStreak <= 10000)) &&
             (!('lastStreakRecoveryDate' in data) || (data.lastStreakRecoveryDate is string && data.lastStreakRecoveryDate.size() <= 16)) &&
             (!('qotdAnsweredCount' in data) || (data.qotdAnsweredCount is int && data.qotdAnsweredCount >= 0 && data.qotdAnsweredCount <= 100000)) &&
             (!('completedSessionsCount' in data) || (data.completedSessionsCount is int && data.completedSessionsCount >= 0 && data.completedSessionsCount <= 100000)) &&
             (!('focusSprintsCount' in data) || (data.focusSprintsCount is int && data.focusSprintsCount >= 0 && data.focusSprintsCount <= 100000)) &&
             (!('srsMasteredCount' in data) || (data.srsMasteredCount is int && data.srsMasteredCount >= 0 && data.srsMasteredCount <= 100000)) &&
             (!('bestSessionAccuracy' in data) || (data.bestSessionAccuracy is int && data.bestSessionAccuracy >= 0 && data.bestSessionAccuracy <= 100)) &&
             (!('phoneNumber' in data) || (data.phoneNumber is string && data.phoneNumber.size() <= 20)) &&
             (!('activeSessionId' in data) || (data.activeSessionId is string && data.activeSessionId.size() <= 64)) &&
             (!('activeDeviceName' in data) || (data.activeDeviceName is string && data.activeDeviceName.size() <= 64)) &&
             (!('sessionUpdatedAt' in data) || isValidTimestamp(data.sessionUpdatedAt)) &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    // 2. QuestionProgressRecord
    function isValidQuestionProgress(data, userId, questionId) {
      return data.userId is string &&
             data.userId == userId &&
             data.userId == request.auth.uid &&
             data.questionId is string &&
             data.questionId == questionId &&
             isValidId(data.questionId) &&
             data.bookmarked is bool &&
             data.attemptsCount is int && data.attemptsCount >= 0 && data.attemptsCount <= 100000 &&
             data.correctCount is int && data.correctCount >= 0 && data.correctCount <= 100000 &&
             data.wrongCount is int && data.wrongCount >= 0 && data.wrongCount <= 100000 &&
             (!('lastOutcome' in data) || (data.lastOutcome is string && data.lastOutcome in ['right', 'wrong'])) &&
             data.clientUpdatedAtMs is int && data.clientUpdatedAtMs >= 0 &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    // 3. MockHistoryRecord
    function isValidMockHistory(data, userId) {
      return data.userId is string &&
             data.userId == userId &&
             data.userId == request.auth.uid &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 120 &&
             data.examId is string && data.examId.size() >= 1 && data.examId.size() <= 64 &&
             data.totalQuestions is int && data.totalQuestions >= 1 && data.totalQuestions <= 500 &&
             data.correctCount is int && data.correctCount >= 0 && data.correctCount <= 500 &&
             data.wrongCount is int && data.wrongCount >= 0 && data.wrongCount <= 500 &&
             data.skippedCount is int && data.skippedCount >= 0 && data.skippedCount <= 500 &&
             data.netScore is number && data.netScore >= -500 && data.netScore <= 500 &&
             data.accuracyPercent is int && data.accuracyPercent >= 0 && data.accuracyPercent <= 100 &&
             data.completedAtMs is int && data.completedAtMs >= 0 &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    // 4. CustomQuestionRecord
    function isValidCustomQuestion(data, userId) {
      return data.userId is string &&
             data.userId == userId &&
             data.userId == request.auth.uid &&
             data.category is string && data.category.size() >= 1 && data.category.size() <= 32 &&
             data.shiftYear is string && data.shiftYear.size() <= 40 &&
             data.subject is string && data.subject.size() >= 1 && data.subject.size() <= 40 &&
             data.difficulty is string && data.difficulty in ['Easy', 'Medium', 'Hard'] &&
             data.questionText is string && data.questionText.size() >= 1 && data.questionText.size() <= 2000 &&
             data.options is list && data.options.size() >= 2 && data.options.size() <= 6 && data.options[0] is string &&
             data.correctIndex is int && data.correctIndex >= 0 && data.correctIndex < data.options.size() &&
             data.explanation is string && data.explanation.size() <= 4000 &&
             data.sourceStatus is string && data.sourceStatus in ['verified', 'unverified'] &&
             data.sourceNote is string && data.sourceNote.size() <= 200 &&
             data.topicId is string && data.topicId.size() <= 80 &&
             data.sourceType is string && data.sourceType.size() >= 1 && data.sourceType.size() <= 40 &&
             data.examYear is string && data.examYear.size() <= 20 &&
             data.examShift is string && data.examShift.size() <= 32 &&
             data.examIds is list && data.examIds.size() >= 1 && data.examIds.size() <= 10 && data.examIds[0] is string &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    // 5. SubscriptionConfig
    function isValidSubscriptionConfig(data) {
      return data.keys().hasAll([
               'singleExam1M', 'singleExam3M', 'singleExam6M', 'singleExam1Y',
               'allExam1M', 'allExam3M', 'allExam6M', 'allExam1Y',
               'freeDailyQuestionLimit', 'trialDays', 'supportWhatsAppNumber',
               'supportEmail', 'catalogVersion', 'updatedAt'
             ]) &&
             data.keys().hasOnly([
               'singleExam1M', 'singleExam3M', 'singleExam6M', 'singleExam1Y',
               'allExam1M', 'allExam3M', 'allExam6M', 'allExam1Y',
               'freeDailyQuestionLimit', 'trialDays', 'supportWhatsAppNumber',
               'supportEmail', 'upiId', 'upiPayeeName', 'grandTestEnabled',
               'catalogVersion', 'updatedAt'
             ]) &&
             data.singleExam1M is int && data.singleExam1M >= 0 && data.singleExam1M <= 100000 &&
             data.singleExam3M is int && data.singleExam3M >= 0 && data.singleExam3M <= 100000 &&
             data.singleExam6M is int && data.singleExam6M >= 0 && data.singleExam6M <= 100000 &&
             data.singleExam1Y is int && data.singleExam1Y >= 0 && data.singleExam1Y <= 100000 &&
             data.allExam1M is int && data.allExam1M >= 0 && data.allExam1M <= 100000 &&
             data.allExam3M is int && data.allExam3M >= 0 && data.allExam3M <= 100000 &&
             data.allExam6M is int && data.allExam6M >= 0 && data.allExam6M <= 100000 &&
             data.allExam1Y is int && data.allExam1Y >= 0 && data.allExam1Y <= 100000 &&
             data.freeDailyQuestionLimit is int && data.freeDailyQuestionLimit >= 1 && data.freeDailyQuestionLimit <= 200 &&
             data.trialDays is int && data.trialDays >= 1 && data.trialDays <= 30 &&
             data.supportWhatsAppNumber is string && data.supportWhatsAppNumber.size() <= 24 &&
             data.supportEmail is string && data.supportEmail.size() <= 120 &&
             (!('upiId' in data) || (data.upiId is string && data.upiId.size() <= 80)) &&
             (!('upiPayeeName' in data) || (data.upiPayeeName is string && data.upiPayeeName.size() <= 80)) &&
             (!('grandTestEnabled' in data) || data.grandTestEnabled is bool) &&
             data.catalogVersion is int && data.catalogVersion >= 0 && data.catalogVersion <= 1000000 &&
             isValidTimestamp(data.updatedAt);
    }

    // 6. UserEntitlement
    function isValidEntitlement(data, userId) {
      return data.keys().hasAll([
               'userId', 'email', 'displayName', 'planTier', 'unlockedExamIds',
               'status', 'trialUsed', 'trialDeviceHash', 'lastCodeId',
               'createdAt', 'updatedAt'
             ]) &&
             data.keys().hasOnly([
               'userId', 'email', 'displayName', 'planTier', 'unlockedExamIds',
               'status', 'startsAt', 'expiresAt', 'trialUsed', 'trialDeviceHash',
               'lastCodeId', 'createdAt', 'updatedAt'
             ]) &&
             data.userId is string && data.userId == userId &&
             data.email is string && data.email.size() <= 120 &&
             data.displayName is string && data.displayName.size() <= 60 &&
             data.planTier is string && data.planTier in ['free', 'trial', 'single_exam', 'all_exam'] &&
             data.unlockedExamIds is list && data.unlockedExamIds.size() <= 10 &&
             (data.unlockedExamIds.size() == 0 || data.unlockedExamIds[0] is string) &&
             data.status is string && data.status in ['active', 'suspended', 'expired'] &&
             (!('startsAt' in data) || data.startsAt is timestamp) &&
             (!('expiresAt' in data) || data.expiresAt is timestamp) &&
             data.trialUsed is bool &&
             data.trialDeviceHash is string && data.trialDeviceHash.size() <= 64 &&
             data.lastCodeId is string && data.lastCodeId.size() <= 64 &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function renewalBaseTime(existingData) {
      return ('expiresAt' in existingData &&
              existingData.expiresAt is timestamp &&
              existingData.expiresAt > request.time &&
              existingData.status == 'active')
        ? existingData.expiresAt
        : request.time;
    }

    function isValidTrialClaimPayload(data, userId) {
      return data.planTier == 'trial' &&
             data.status == 'active' &&
             data.trialUsed == true &&
             data.unlockedExamIds.size() == 1 &&
             data.unlockedExamIds[0] == 'all' &&
             data.trialDeviceHash.size() == 64 &&
             'expiresAt' in data &&
             data.expiresAt is timestamp &&
             data.expiresAt <= request.time + duration.value(4, 'd') &&
             !exists(/databases/$(database)/documents/deviceTrialLocks/$(data.trialDeviceHash)) &&
             existsAfter(/databases/$(database)/documents/deviceTrialLocks/$(data.trialDeviceHash)) &&
             getAfter(/databases/$(database)/documents/deviceTrialLocks/$(data.trialDeviceHash)).data.ownerUid == userId;
    }

    function isValidCodeRedeemExams(incomingData, codeData, hasExisting, existingData) {
      return (codeData.planTier == 'all_exam' &&
              incomingData.unlockedExamIds.size() == 1 &&
              incomingData.unlockedExamIds[0] == 'all') ||
             (codeData.planTier == 'single_exam' &&
              incomingData.unlockedExamIds.size() >= 1 &&
              incomingData.unlockedExamIds.size() <= 5 &&
              incomingData.unlockedExamIds.hasAll(codeData.unlockedExamIds) &&
              ((hasExisting &&
                existingData.planTier == 'single_exam' &&
                existingData.status == 'active' &&
                'expiresAt' in existingData &&
                existingData.expiresAt is timestamp &&
                existingData.expiresAt > request.time)
                ? incomingData.unlockedExamIds.size() <= existingData.unlockedExamIds.size() + codeData.unlockedExamIds.size()
                : incomingData.unlockedExamIds == codeData.unlockedExamIds));
    }

    function isValidCodeRedemption(incomingData, userId, hasExisting, existingData) {
      let codeId = incomingData.lastCodeId;
      return codeId.size() >= 6 &&
             isValidId(codeId) &&
             incomingData.status == 'active' &&
             (!hasExisting || codeId != existingData.lastCodeId) &&
             exists(/databases/$(database)/documents/accessCodes/$(codeId)) &&
             get(/databases/$(database)/documents/accessCodes/$(codeId)).data.status == 'active' &&
             getAfter(/databases/$(database)/documents/accessCodes/$(codeId)).data.status == 'redeemed' &&
             getAfter(/databases/$(database)/documents/accessCodes/$(codeId)).data.redeemedByUid == userId &&
             incomingData.planTier == get(/databases/$(database)/documents/accessCodes/$(codeId)).data.planTier &&
             isValidCodeRedeemExams(
               incomingData,
               get(/databases/$(database)/documents/accessCodes/$(codeId)).data,
               hasExisting,
               existingData
             ) &&
             'expiresAt' in incomingData &&
             incomingData.expiresAt is timestamp &&
             incomingData.expiresAt <= (hasExisting ? renewalBaseTime(existingData) : request.time) +
               duration.value(get(/databases/$(database)/documents/accessCodes/$(codeId)).data.tenureDays + 1, 'd');
    }

    // 7. AccessCode
    function isValidAccessCode(data, codeId) {
      return data.keys().hasAll([
               'code', 'planTier', 'unlockedExamIds', 'tenureDays',
               'status', 'buyerNote', 'createdByEmail', 'createdAt'
             ]) &&
             data.keys().hasOnly([
               'code', 'planTier', 'unlockedExamIds', 'tenureDays',
               'status', 'buyerNote', 'createdByEmail', 'createdAt',
               'redeemedByUid', 'redeemedByEmail', 'redeemedAt'
             ]) &&
             data.code is string && data.code == codeId && data.code.size() >= 6 && data.code.size() <= 64 &&
             data.planTier is string && data.planTier in ['single_exam', 'all_exam'] &&
             data.unlockedExamIds is list && data.unlockedExamIds.size() >= 1 && data.unlockedExamIds.size() <= 5 &&
             data.unlockedExamIds[0] is string &&
             data.tenureDays is int && data.tenureDays in [30, 90, 180, 365] &&
             data.status is string && data.status in ['active', 'redeemed', 'revoked'] &&
             data.buyerNote is string && data.buyerNote.size() <= 120 &&
             data.createdByEmail is string && data.createdByEmail.size() <= 120 &&
             isValidTimestamp(data.createdAt) &&
             (!('redeemedByUid' in data) || (data.redeemedByUid is string && data.redeemedByUid.size() <= 128)) &&
             (!('redeemedByEmail' in data) || (data.redeemedByEmail is string && data.redeemedByEmail.size() <= 120)) &&
             (!('redeemedAt' in data) || isValidTimestamp(data.redeemedAt));
    }

    // 8. DeviceTrialLock
    function isValidDeviceTrialLock(data, deviceHash) {
      return data.keys().hasAll([
               'deviceHash', 'shortDeviceCode', 'ownerUid', 'maskedEmail',
               'deviceName', 'claimedAt'
             ]) &&
             data.keys().hasOnly([
               'deviceHash', 'shortDeviceCode', 'ownerUid', 'maskedEmail',
               'deviceName', 'claimedAt'
             ]) &&
             data.deviceHash is string && data.deviceHash == deviceHash && data.deviceHash.size() == 64 &&
             data.shortDeviceCode is string && data.shortDeviceCode.size() >= 6 && data.shortDeviceCode.size() <= 16 &&
             data.ownerUid is string && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128 &&
             data.maskedEmail is string && data.maskedEmail.size() <= 120 &&
             data.deviceName is string && data.deviceName.size() <= 64 &&
             isValidTimestamp(data.claimedAt);
    }

    // 9. QuestionPack & PackQuestion
    function isValidQuestionPack(data, packId) {
      return data.keys().hasAll([
               'packId', 'title', 'examId', 'stage', 'subject',
               'questionCount', 'isPremiumOnly', 'status', 'version',
               'createdAt', 'updatedAt'
             ]) &&
             data.keys().hasOnly([
               'packId', 'title', 'examId', 'stage', 'subject',
               'questionCount', 'isPremiumOnly', 'status', 'version',
               'createdAt', 'updatedAt'
             ]) &&
             data.packId is string && data.packId == packId &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 120 &&
             data.examId is string && data.examId.size() >= 1 && data.examId.size() <= 64 &&
             data.stage is string && data.stage in ['all', 'prelims', 'mains'] &&
             data.subject is string && data.subject.size() <= 40 &&
             data.questionCount is int && data.questionCount >= 0 && data.questionCount <= 5000 &&
             data.isPremiumOnly is bool &&
             data.status is string && data.status in ['draft', 'published'] &&
             data.version is int && data.version >= 1 && data.version <= 1000000 &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidPackQuestion(data, packId) {
      return data.keys().hasAll([
               'packId', 'packStatus', 'examId', 'category', 'shiftYear',
               'subject', 'difficulty', 'questionText', 'options', 'correctIndex',
               'explanation', 'sourceStatus', 'sourceNote', 'topicId',
               'sourceType', 'examYear', 'examShift', 'sortOrder', 'createdAt'
             ]) &&
             data.keys().hasOnly([
               'packId', 'packStatus', 'examId', 'category', 'shiftYear',
               'subject', 'difficulty', 'questionText', 'options', 'correctIndex',
               'explanation', 'sourceStatus', 'sourceNote', 'topicId',
               'sourceType', 'examYear', 'examShift', 'sortOrder', 'createdAt'
             ]) &&
             data.packId is string && data.packId == packId &&
             data.packStatus is string && data.packStatus in ['draft', 'published'] &&
             data.examId is string && data.examId.size() >= 1 && data.examId.size() <= 64 &&
             data.category is string && data.category.size() >= 1 && data.category.size() <= 32 &&
             data.shiftYear is string && data.shiftYear.size() <= 40 &&
             data.subject is string && data.subject.size() >= 1 && data.subject.size() <= 40 &&
             data.difficulty is string && data.difficulty in ['Easy', 'Medium', 'Hard'] &&
             data.questionText is string && data.questionText.size() >= 1 && data.questionText.size() <= 2000 &&
             data.options is list && data.options.size() >= 2 && data.options.size() <= 6 && data.options[0] is string &&
             data.correctIndex is int && data.correctIndex >= 0 && data.correctIndex < data.options.size() &&
             data.explanation is string && data.explanation.size() <= 4000 &&
             data.sourceStatus is string && data.sourceStatus in ['verified', 'unverified'] &&
             data.sourceNote is string && data.sourceNote.size() <= 200 &&
             data.topicId is string && data.topicId.size() <= 80 &&
             data.sourceType is string && data.sourceType.size() >= 1 && data.sourceType.size() <= 40 &&
             data.examYear is string && data.examYear.size() <= 20 &&
             data.examShift is string && data.examShift.size() <= 32 &&
             data.sortOrder is int && data.sortOrder >= 0 && data.sortOrder <= 100000 &&
             isValidTimestamp(data.createdAt);
    }

    // 10. ClockSyncPing
    function isValidClockSync(data, userId) {
      return data.keys().hasAll(['userId', 'serverTime']) &&
             data.keys().hasOnly(['userId', 'serverTime']) &&
             data.userId is string && data.userId == userId &&
             isValidTimestamp(data.serverTime);
    }

    // 11. DoubtThread
    function isValidDoubt(data, doubtId) {
      return data.keys().hasAll([
               'doubtId', 'userId', 'studentName', 'studentEmail', 'examId',
               'subject', 'questionId', 'questionPreview', 'doubtText',
               'status', 'adminReply', 'repliedBy', 'studentReadReply',
               'createdAt', 'updatedAt'
             ]) &&
             data.keys().hasOnly([
               'doubtId', 'userId', 'studentName', 'studentEmail', 'examId',
               'subject', 'questionId', 'questionPreview', 'doubtText',
               'status', 'adminReply', 'repliedBy', 'repliedAt',
               'studentReadReply', 'createdAt', 'updatedAt'
             ]) &&
             data.doubtId is string && data.doubtId == doubtId &&
             data.userId is string && isValidId(data.userId) &&
             data.studentName is string && data.studentName.size() <= 60 &&
             data.studentEmail is string && data.studentEmail.size() <= 120 &&
             data.examId is string && data.examId.size() >= 1 && data.examId.size() <= 64 &&
             data.subject is string && data.subject.size() >= 1 && data.subject.size() <= 40 &&
             data.questionId is string && data.questionId.size() <= 128 &&
             data.questionPreview is string && data.questionPreview.size() <= 280 &&
             data.doubtText is string && data.doubtText.size() >= 3 && data.doubtText.size() <= 1500 &&
             data.status is string && data.status in ['open', 'answered', 'closed'] &&
             data.adminReply is string && data.adminReply.size() <= 2500 &&
             data.repliedBy is string && data.repliedBy.size() <= 80 &&
             (!('repliedAt' in data) || isValidTimestamp(data.repliedAt)) &&
             data.studentReadReply is bool &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    // 12. ExamAnnouncement
    function isValidAnnouncement(data, announcementId) {
      return data.keys().hasAll([
               'announcementId', 'title', 'body', 'category', 'targetExamId',
               'priority', 'actionUrl', 'createdByEmail', 'createdAt'
             ]) &&
             data.keys().hasOnly([
               'announcementId', 'title', 'body', 'category', 'targetExamId',
               'priority', 'actionUrl', 'createdByEmail', 'createdAt'
             ]) &&
             data.announcementId is string && data.announcementId == announcementId &&
             data.title is string && data.title.size() >= 2 && data.title.size() <= 120 &&
             data.body is string && data.body.size() >= 2 && data.body.size() <= 2000 &&
             data.category is string && data.category in ['exam_alert', 'vacancy', 'news', 'study_tip', 'app_update'] &&
             data.targetExamId is string && data.targetExamId.size() >= 1 && data.targetExamId.size() <= 64 &&
             data.priority is string && data.priority in ['normal', 'urgent'] &&
             data.actionUrl is string && data.actionUrl.size() <= 300 &&
             data.createdByEmail is string && data.createdByEmail.size() <= 120 &&
             isValidTimestamp(data.createdAt);
    }

    // 13. DirectNotification
    function isValidDirectNotification(data, userId, notificationId) {
      return data.keys().hasAll([
               'notificationId', 'userId', 'title', 'body', 'type',
               'referenceId', 'actionUrl', 'read', 'createdByEmail', 'createdAt'
             ]) &&
             data.keys().hasOnly([
               'notificationId', 'userId', 'title', 'body', 'type',
               'referenceId', 'actionUrl', 'read', 'createdByEmail', 'createdAt'
             ]) &&
             data.notificationId is string && data.notificationId == notificationId &&
             data.userId is string && data.userId == userId &&
             data.title is string && data.title.size() >= 2 && data.title.size() <= 120 &&
             data.body is string && data.body.size() >= 2 && data.body.size() <= 2000 &&
             data.type is string && data.type in ['custom_admin', 'doubt_reply', 'account_notice'] &&
             data.referenceId is string && data.referenceId.size() <= 128 &&
             data.actionUrl is string && data.actionUrl.size() <= 300 &&
             data.read is bool &&
             data.createdByEmail is string && data.createdByEmail.size() <= 120 &&
             isValidTimestamp(data.createdAt);
    }

    // 14. PaymentRequest
    function isValidPaymentRequest(data, requestId) {
      return data.keys().hasAll([
               'requestId', 'userId', 'studentName', 'studentEmail', 'planTier',
               'unlockedExamIds', 'tenureDays', 'amountInr', 'utrNumber', 'payerName',
               'status', 'adminNote', 'reviewedByEmail', 'createdAt', 'updatedAt'
             ]) &&
             data.keys().hasOnly([
               'requestId', 'userId', 'studentName', 'studentEmail', 'planTier',
               'unlockedExamIds', 'tenureDays', 'amountInr', 'utrNumber', 'payerName',
               'status', 'adminNote', 'reviewedByEmail', 'createdAt', 'updatedAt'
             ]) &&
             data.requestId is string && data.requestId == requestId &&
             data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.studentName is string && data.studentName.size() <= 60 &&
             data.studentEmail is string && data.studentEmail.size() <= 120 &&
             data.planTier is string && data.planTier in ['single_exam', 'all_exam'] &&
             data.unlockedExamIds is list && data.unlockedExamIds.size() >= 1 && data.unlockedExamIds.size() <= 5 &&
             data.unlockedExamIds[0] is string &&
             data.tenureDays is int && data.tenureDays >= 1 && data.tenureDays <= 365 &&
             data.amountInr is int && data.amountInr >= 0 && data.amountInr <= 100000 &&
             data.utrNumber is string && data.utrNumber.size() >= 6 && data.utrNumber.size() <= 32 &&
             data.payerName is string && data.payerName.size() <= 80 &&
             data.status is string && data.status in ['pending', 'approved', 'rejected'] &&
             data.adminNote is string && data.adminNote.size() <= 300 &&
             data.reviewedByEmail is string && data.reviewedByEmail.size() <= 120 &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    // 15. QuestionReport
    function isValidQuestionReport(data, reportId) {
      return data.keys().hasAll([
               'reportId', 'userId', 'studentName', 'studentEmail', 'examId',
               'subject', 'questionId', 'questionPreview', 'reason', 'note',
               'status', 'adminResolutionNote', 'createdAt', 'updatedAt'
             ]) &&
             data.keys().hasOnly([
               'reportId', 'userId', 'studentName', 'studentEmail', 'examId',
               'subject', 'questionId', 'questionPreview', 'reason', 'note',
               'status', 'adminResolutionNote', 'createdAt', 'updatedAt'
             ]) &&
             data.reportId is string && data.reportId == reportId &&
             data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.studentName is string && data.studentName.size() <= 60 &&
             data.studentEmail is string && data.studentEmail.size() <= 120 &&
             data.examId is string && data.examId.size() <= 64 &&
             data.subject is string && data.subject.size() <= 40 &&
             data.questionId is string && data.questionId.size() >= 1 && data.questionId.size() <= 128 &&
             data.questionPreview is string && data.questionPreview.size() <= 300 &&
             data.reason is string && data.reason in ['wrong_key', 'typo', 'outdated', 'wrong_mapping', 'other'] &&
             data.note is string && data.note.size() <= 1000 &&
             data.status is string && data.status in ['open', 'resolved', 'dismissed'] &&
             data.adminResolutionNote is string && data.adminResolutionNote.size() <= 500 &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    // 16. GrandTest (Weekly All-India Grand Test)
    function isValidGrandTest(data, testId) {
      return data.keys().hasAll([
               'testId', 'title', 'examId', 'weekLabel', 'questionCount',
               'durationMinutes', 'negativeMarks', 'status', 'startsAtMs',
               'endsAtMs', 'createdByEmail', 'createdAt', 'updatedAt'
             ]) &&
             data.keys().hasOnly([
               'testId', 'title', 'examId', 'weekLabel', 'questionCount',
               'durationMinutes', 'negativeMarks', 'status', 'startsAtMs',
               'endsAtMs', 'createdByEmail', 'createdAt', 'updatedAt'
             ]) &&
             data.testId is string && data.testId == testId &&
             data.title is string && data.title.size() >= 3 && data.title.size() <= 120 &&
             data.examId is string && data.examId.size() >= 1 && data.examId.size() <= 64 &&
             data.weekLabel is string && data.weekLabel.size() >= 1 && data.weekLabel.size() <= 40 &&
             data.questionCount is int && data.questionCount >= 10 && data.questionCount <= 200 &&
             data.durationMinutes is int && data.durationMinutes >= 5 && data.durationMinutes <= 240 &&
             data.negativeMarks is number && data.negativeMarks >= 0 && data.negativeMarks <= 1 &&
             data.status is string && data.status in ['draft', 'live', 'closed'] &&
             data.startsAtMs is int && data.startsAtMs >= 0 &&
             data.endsAtMs is int && data.endsAtMs >= data.startsAtMs &&
             data.createdByEmail is string && data.createdByEmail.size() <= 120 &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    // 17. GrandTestEntry (Immutable 1-attempt-per-user Leaderboard Entry)
    function isValidGrandTestEntry(data, testId, userId) {
      return data.keys().hasAll([
               'testId', 'userId', 'studentName', 'examId', 'netScore',
               'correctCount', 'wrongCount', 'skippedCount', 'totalQuestions',
               'accuracyPercent', 'timeTakenSeconds', 'submittedAt'
             ]) &&
             data.keys().hasOnly([
               'testId', 'userId', 'studentName', 'examId', 'netScore',
               'correctCount', 'wrongCount', 'skippedCount', 'totalQuestions',
               'accuracyPercent', 'timeTakenSeconds', 'submittedAt'
             ]) &&
             data.testId is string && data.testId == testId &&
             data.userId is string && data.userId == userId &&
             data.studentName is string && data.studentName.size() >= 1 && data.studentName.size() <= 60 &&
             data.examId is string && data.examId.size() >= 1 && data.examId.size() <= 64 &&
             data.totalQuestions is int && data.totalQuestions >= 1 && data.totalQuestions <= 200 &&
             data.correctCount is int && data.correctCount >= 0 && data.correctCount <= data.totalQuestions &&
             data.wrongCount is int && data.wrongCount >= 0 && data.wrongCount <= data.totalQuestions &&
             data.skippedCount is int && data.skippedCount >= 0 && data.skippedCount <= data.totalQuestions &&
             (data.correctCount + data.wrongCount + data.skippedCount) == data.totalQuestions &&
             data.netScore is number && data.netScore >= -200 && data.netScore <= data.totalQuestions &&
             data.accuracyPercent is int && data.accuracyPercent >= 0 && data.accuracyPercent <= 100 &&
             data.timeTakenSeconds is int && data.timeTakenSeconds >= 0 && data.timeTakenSeconds <= 20000 &&
             isValidTimestamp(data.submittedAt);
    }

    // ------------------------------------------------------------------------
    // /users/{userId} — Owner-isolated profile; Owner Admin may inspect directory
    // ------------------------------------------------------------------------
    match /users/{userId} {
      allow get: if (isOwner(userId) || isAdmin()) && isValidId(userId);
      allow list: if isAdmin();

      allow create: if isOwner(userId) &&
                       isValidId(userId) &&
                       incoming().keys().hasAll([
                         'userId', 'displayName', 'role', 'targetYear', 'focusSubject',
                         'activeExamId', 'themePreference', 'negativeMarking', 'useTimeLimit',
                         'secondsPerQuestion', 'keepScreenOn', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'email', 'lastDeviceHash', 'displayName', 'role',
                         'targetYear', 'focusSubject', 'phoneNumber', 'activeExamId',
                         'themePreference', 'negativeMarking', 'useTimeLimit',
                         'secondsPerQuestion', 'keepScreenOn', 'onboardingCompleted',
                         'dailyGoalQuestions', 'currentStreakDays', 'longestStreakDays',
                         'lastGoalMetDate', 'todayStudyDate', 'todayAnsweredCount',
                         'totalXp', 'weeklyXp', 'weeklyKey', 'weeklyQuestions',
                         'weeklyCorrect', 'weeklySessions', 'weeklyClaimedIds',
                         'unlockedBadgeIds', 'streakShields', 'lastShieldEarnedStreak',
                         'lastStreakRecoveryDate', 'qotdAnsweredCount',
                         'completedSessionsCount', 'focusSprintsCount',
                         'srsMasteredCount', 'bestSessionAccuracy',
                         'activeSessionId', 'activeDeviceName', 'sessionUpdatedAt',
                         'createdAt', 'updatedAt'
                       ]) &&
                       isValidUserProfile(incoming(), userId);

      allow update: if isOwner(userId) &&
                       isValidId(userId) &&
                       isValidUserProfile(incoming(), userId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt && (
                         // Action 1: Update learner profile, contact info, study preferences, daily goal & gamification
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'email', 'lastDeviceHash', 'displayName', 'role', 'targetYear',
                           'focusSubject', 'phoneNumber', 'activeExamId', 'themePreference',
                           'negativeMarking', 'useTimeLimit', 'secondsPerQuestion',
                           'keepScreenOn', 'onboardingCompleted', 'dailyGoalQuestions',
                           'currentStreakDays', 'longestStreakDays', 'lastGoalMetDate',
                           'todayStudyDate', 'todayAnsweredCount',
                           'totalXp', 'weeklyXp', 'weeklyKey', 'weeklyQuestions',
                           'weeklyCorrect', 'weeklySessions', 'weeklyClaimedIds',
                           'unlockedBadgeIds', 'streakShields', 'lastShieldEarnedStreak',
                           'lastStreakRecoveryDate', 'qotdAnsweredCount',
                           'completedSessionsCount', 'focusSprintsCount',
                           'srsMasteredCount', 'bestSessionAccuracy',
                           'updatedAt'
                         ]) ||
                         // Action 2: Claim or refresh single-device active session lock
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'activeSessionId', 'activeDeviceName', 'sessionUpdatedAt', 'updatedAt'
                         ])
                       );

      allow delete: if (isOwner(userId) || isAdmin()) && isValidId(userId);

      match /progress/{questionId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(questionId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(userId) &&
                         isValidId(questionId) &&
                         incoming().keys().hasAll([
                           'userId', 'questionId', 'bookmarked', 'attemptsCount',
                           'correctCount', 'wrongCount', 'clientUpdatedAtMs',
                           'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId', 'questionId', 'bookmarked', 'attemptsCount',
                           'correctCount', 'wrongCount', 'lastOutcome',
                           'clientUpdatedAtMs', 'createdAt', 'updatedAt'
                         ]) &&
                         isValidQuestionProgress(incoming(), userId, questionId);

        allow update: if isOwner(userId) &&
                         isValidId(userId) &&
                         isValidId(questionId) &&
                         isValidQuestionProgress(incoming(), userId, questionId) &&
                         incoming().userId == existing().userId &&
                         incoming().questionId == existing().questionId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'bookmarked', 'attemptsCount', 'correctCount', 'wrongCount',
                           'lastOutcome', 'clientUpdatedAtMs', 'updatedAt'
                         ]);

        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(questionId);
      }

      match /mockHistory/{mockId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(mockId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(userId) &&
                         isValidId(mockId) &&
                         incoming().keys().hasAll([
                           'userId', 'title', 'examId', 'totalQuestions',
                           'correctCount', 'wrongCount', 'skippedCount',
                           'netScore', 'accuracyPercent', 'completedAtMs',
                           'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId', 'title', 'examId', 'totalQuestions',
                           'correctCount', 'wrongCount', 'skippedCount',
                           'netScore', 'accuracyPercent', 'completedAtMs',
                           'createdAt', 'updatedAt'
                         ]) &&
                         isValidMockHistory(incoming(), userId);

        allow update: if isOwner(userId) &&
                         isValidId(userId) &&
                         isValidId(mockId) &&
                         isValidMockHistory(incoming(), userId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'title', 'examId', 'totalQuestions', 'correctCount',
                           'wrongCount', 'skippedCount', 'netScore',
                           'accuracyPercent', 'completedAtMs', 'updatedAt'
                         ]);

        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(mockId);
      }

      match /customQuestions/{questionId} {
        allow get: if (isOwner(userId) || isAdmin()) && isValidId(userId) && isValidId(questionId);
        allow list: if isOwner(userId) || isAdmin();

        allow create: if isAdmin() &&
                         isOwner(userId) &&
                         isValidId(userId) &&
                         isValidId(questionId) &&
                         incoming().keys().hasAll([
                           'userId', 'category', 'shiftYear', 'subject', 'difficulty',
                           'questionText', 'options', 'correctIndex', 'explanation',
                           'sourceStatus', 'sourceNote', 'topicId', 'sourceType',
                           'examYear', 'examShift', 'examIds', 'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId', 'category', 'shiftYear', 'subject', 'difficulty',
                           'questionText', 'options', 'correctIndex', 'explanation',
                           'sourceStatus', 'sourceNote', 'topicId', 'sourceType',
                           'examYear', 'examShift', 'examIds', 'createdAt', 'updatedAt'
                         ]) &&
                         isValidCustomQuestion(incoming(), userId);

        allow update: if isAdmin() &&
                         isOwner(userId) &&
                         isValidId(userId) &&
                         isValidId(questionId) &&
                         isValidCustomQuestion(incoming(), userId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'category', 'shiftYear', 'subject', 'difficulty',
                           'questionText', 'options', 'correctIndex', 'explanation',
                           'sourceStatus', 'sourceNote', 'topicId', 'sourceType',
                           'examYear', 'examShift', 'examIds', 'updatedAt'
                         ]);

        allow delete: if isAdmin() && isOwner(userId) && isValidId(userId) && isValidId(questionId);
      }

      match /notifications/{notificationId} {
        allow get: if (isOwner(userId) || isAdmin()) && isValidId(userId) && isValidId(notificationId);
        allow list: if isOwner(userId) || isAdmin();

        allow create: if isAdmin() &&
                         isValidId(userId) &&
                         isValidId(notificationId) &&
                         isValidDirectNotification(incoming(), userId, notificationId);

        allow update: if isOwner(userId) &&
                         isValidId(userId) &&
                         isValidId(notificationId) &&
                         isValidDirectNotification(incoming(), userId, notificationId) &&
                         incoming().notificationId == existing().notificationId &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['read']);

        allow delete: if (isOwner(userId) || isAdmin()) && isValidId(userId) && isValidId(notificationId);
      }
    }

    // ------------------------------------------------------------------------
    // /appConfig/{configId} — Subscription pricing, support contacts & catalogVersion
    // ------------------------------------------------------------------------
    match /appConfig/{configId} {
      allow get: if isSignedIn() && configId == 'subscriptionConfig';
      allow list: if false;
      allow create, update: if isAdmin() &&
                               configId == 'subscriptionConfig' &&
                               isValidSubscriptionConfig(incoming());
      allow delete: if false;
    }

    // ------------------------------------------------------------------------
    // /entitlements/{userId} — Tamper-protected subscription & trial state
    // ------------------------------------------------------------------------
    match /entitlements/{userId} {
      allow get: if (isOwner(userId) || isAdmin()) && isValidId(userId);
      allow list: if isAdmin();

      allow create: if isValidId(userId) &&
                       isValidEntitlement(incoming(), userId) && (
                         isAdmin() ||
                         (isOwner(userId) && (
                           // Path A: Initial free tier bootstrap
                           (incoming().planTier == 'free' &&
                            incoming().status == 'active' &&
                            incoming().trialUsed == false &&
                            incoming().unlockedExamIds.size() == 0 &&
                            incoming().lastCodeId == '' &&
                            incoming().trialDeviceHash == '') ||
                           // Path B: First-time atomic 3-day device-locked free trial
                           isValidTrialClaimPayload(incoming(), userId) ||
                           // Path C: First-time atomic single-use access code redemption
                           (incoming().trialUsed == false &&
                            incoming().trialDeviceHash == '' &&
                            isValidCodeRedemption(incoming(), userId, false, {}))
                         ))
                       );

      allow update: if isValidId(userId) &&
                       isValidEntitlement(incoming(), userId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt && (
                         isAdmin() ||
                         (isOwner(userId) && (
                           // Action 1: Atomic 3-day free trial claim (once per user + once per device)
                           (existing().trialUsed == false &&
                            incoming().lastCodeId == existing().lastCodeId &&
                            isValidTrialClaimPayload(incoming(), userId) &&
                            incoming().diff(existing()).affectedKeys().hasOnly([
                              'email', 'displayName', 'planTier', 'unlockedExamIds',
                              'status', 'startsAt', 'expiresAt', 'trialUsed',
                              'trialDeviceHash', 'updatedAt'
                            ])) ||
                           // Action 2: Atomic single-use access code redemption / renewal
                           (incoming().trialUsed == existing().trialUsed &&
                            incoming().trialDeviceHash == existing().trialDeviceHash &&
                            isValidCodeRedemption(incoming(), userId, true, existing()) &&
                            incoming().diff(existing()).affectedKeys().hasOnly([
                              'email', 'displayName', 'planTier', 'unlockedExamIds',
                              'status', 'startsAt', 'expiresAt', 'lastCodeId', 'updatedAt'
                            ]))
                         ))
                       );

      allow delete: if isAdmin() && isValidId(userId);
    }

    // ------------------------------------------------------------------------
    // /accessCodes/{codeId} — Admin-generated post-payment vouchers
    // ------------------------------------------------------------------------
    match /accessCodes/{codeId} {
      allow get: if isSignedIn() && isValidId(codeId);
      allow list: if isAdmin();

      allow create: if isAdmin() &&
                       isValidId(codeId) &&
                       isValidAccessCode(incoming(), codeId) &&
                       incoming().status == 'active';

      allow update: if isValidId(codeId) &&
                       isValidAccessCode(incoming(), codeId) &&
                       incoming().code == existing().code &&
                       incoming().planTier == existing().planTier &&
                       incoming().unlockedExamIds == existing().unlockedExamIds &&
                       incoming().tenureDays == existing().tenureDays &&
                       incoming().createdByEmail == existing().createdByEmail &&
                       incoming().createdAt == existing().createdAt && (
                         (isAdmin() &&
                          incoming().diff(existing()).affectedKeys().hasOnly([
                            'status', 'buyerNote'
                          ])) ||
                         (isSignedIn() &&
                          existing().status == 'active' &&
                          incoming().status == 'redeemed' &&
                          incoming().redeemedByUid == request.auth.uid &&
                          incoming().diff(existing()).affectedKeys().hasOnly([
                            'status', 'redeemedByUid', 'redeemedByEmail', 'redeemedAt'
                          ]) &&
                          existsAfter(/databases/$(database)/documents/entitlements/$(request.auth.uid)) &&
                          getAfter(/databases/$(database)/documents/entitlements/$(request.auth.uid)).data.lastCodeId == codeId)
                       );

      allow delete: if isAdmin() && isValidId(codeId);
    }

    // ------------------------------------------------------------------------
    // /deviceTrialLocks/{deviceHash} — Anti-abuse 1-trial-per-phone registry
    // ------------------------------------------------------------------------
    match /deviceTrialLocks/{deviceHash} {
      allow get: if isSignedIn() && isValidId(deviceHash);
      allow list: if isAdmin();

      allow create: if isSignedIn() &&
                       isValidId(deviceHash) &&
                       deviceHash.size() == 64 &&
                       isValidDeviceTrialLock(incoming(), deviceHash) &&
                       incoming().ownerUid == request.auth.uid &&
                       existsAfter(/databases/$(database)/documents/entitlements/$(request.auth.uid)) &&
                       getAfter(/databases/$(database)/documents/entitlements/$(request.auth.uid)).data.trialDeviceHash == deviceHash;

      allow update: if false;
      allow delete: if isAdmin() && isValidId(deviceHash);
    }

    // ------------------------------------------------------------------------
    // /questionPacks/{packId} — Admin-published OTA question banks
    // ------------------------------------------------------------------------
    match /questionPacks/{packId} {
      allow get: if isSignedIn() && isValidId(packId) && (isAdmin() || existing().status == 'published');
      allow list: if isAdmin() || (isSignedIn() && resource.data.status == 'published');

      allow create: if isAdmin() &&
                       isValidId(packId) &&
                       isValidQuestionPack(incoming(), packId);

      allow update: if isAdmin() &&
                       isValidId(packId) &&
                       isValidQuestionPack(incoming(), packId) &&
                       incoming().packId == existing().packId &&
                       incoming().createdAt == existing().createdAt;

      allow delete: if isAdmin() && isValidId(packId);

      match /questions/{questionId} {
        allow get: if isSignedIn() && isValidId(packId) && isValidId(questionId) &&
                      (isAdmin() || existing().packStatus == 'published');
        allow list: if isAdmin() || (isSignedIn() && resource.data.packStatus == 'published');

        allow create: if isAdmin() &&
                         isValidId(packId) &&
                         isValidId(questionId) &&
                         isValidPackQuestion(incoming(), packId);

        allow update: if isAdmin() &&
                         isValidId(packId) &&
                         isValidId(questionId) &&
                         isValidPackQuestion(incoming(), packId) &&
                         incoming().packId == existing().packId &&
                         incoming().createdAt == existing().createdAt;

        allow delete: if isAdmin() && isValidId(packId) && isValidId(questionId);
      }
    }

    // ------------------------------------------------------------------------
    // /clockSync/{userId} — Lightweight server timestamp anchor
    // ------------------------------------------------------------------------
    match /clockSync/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;
      allow create, update: if isOwner(userId) &&
                               isValidId(userId) &&
                               isValidClockSync(incoming(), userId);
      allow delete: if false;
    }

    // ------------------------------------------------------------------------
    // /doubts/{doubtId} — Student clinical/exam doubts & faculty replies
    // ------------------------------------------------------------------------
    match /doubts/{doubtId} {
      allow get: if isSignedIn() && isValidId(doubtId) &&
                    (isAdmin() || existing().userId == request.auth.uid);
      allow list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);

      allow create: if isSignedIn() &&
                       isValidId(doubtId) &&
                       isValidDoubt(incoming(), doubtId) &&
                       incoming().userId == request.auth.uid &&
                       incoming().status == 'open' &&
                       incoming().adminReply == '' &&
                       incoming().repliedBy == '' &&
                       !('repliedAt' in incoming()) &&
                       incoming().studentReadReply == true;

      allow update: if isValidId(doubtId) &&
                       isValidDoubt(incoming(), doubtId) &&
                       incoming().doubtId == existing().doubtId &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt && (
                         (isAdmin() &&
                          incoming().diff(existing()).affectedKeys().hasOnly([
                            'status', 'adminReply', 'repliedBy', 'repliedAt',
                            'studentReadReply', 'updatedAt'
                          ])) ||
                         (isSignedIn() &&
                          existing().userId == request.auth.uid &&
                          incoming().adminReply == existing().adminReply &&
                          incoming().repliedBy == existing().repliedBy &&
                          incoming().diff(existing()).affectedKeys().hasOnly([
                            'studentReadReply', 'status', 'updatedAt'
                          ]) &&
                          (incoming().status == existing().status || incoming().status == 'closed'))
                       );

      allow delete: if isValidId(doubtId) &&
                       (isAdmin() || (isSignedIn() && existing().userId == request.auth.uid));
    }

    // ------------------------------------------------------------------------
    // /announcements/{announcementId} — Admin-pushed live exam news & alerts
    // ------------------------------------------------------------------------
    match /announcements/{announcementId} {
      allow get: if isSignedIn() && isValidId(announcementId);
      allow list: if isSignedIn();

      allow create: if isAdmin() &&
                       isValidId(announcementId) &&
                       isValidAnnouncement(incoming(), announcementId);

      allow update: if isAdmin() &&
                       isValidId(announcementId) &&
                       isValidAnnouncement(incoming(), announcementId) &&
                       incoming().announcementId == existing().announcementId &&
                       incoming().createdAt == existing().createdAt;

      allow delete: if isAdmin() && isValidId(announcementId);
    }

    // ------------------------------------------------------------------------
    // /paymentRequests/{requestId} — Student UPI UTR payment requests
    // ------------------------------------------------------------------------
    match /paymentRequests/{requestId} {
      allow get: if isSignedIn() && isValidId(requestId) &&
                    (isAdmin() || existing().userId == request.auth.uid);
      allow list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);

      allow create: if isSignedIn() &&
                       isValidId(requestId) &&
                       isValidPaymentRequest(incoming(), requestId) &&
                       incoming().userId == request.auth.uid &&
                       incoming().status == 'pending' &&
                       incoming().adminNote == '' &&
                       incoming().reviewedByEmail == '';

      allow update: if isAdmin() &&
                       isValidId(requestId) &&
                       isValidPaymentRequest(incoming(), requestId) &&
                       incoming().requestId == existing().requestId &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'status', 'adminNote', 'reviewedByEmail', 'updatedAt'
                       ]);

      allow delete: if isAdmin() && isValidId(requestId);
    }

    // ------------------------------------------------------------------------
    // /questionReports/{reportId} — Student-flagged MCQ error reports
    // ------------------------------------------------------------------------
    match /questionReports/{reportId} {
      allow get: if isSignedIn() && isValidId(reportId) &&
                    (isAdmin() || existing().userId == request.auth.uid);
      allow list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);

      allow create: if isSignedIn() &&
                       isValidId(reportId) &&
                       isValidQuestionReport(incoming(), reportId) &&
                       incoming().userId == request.auth.uid &&
                       incoming().status == 'open' &&
                       incoming().adminResolutionNote == '';

      allow update: if isAdmin() &&
                       isValidId(reportId) &&
                       isValidQuestionReport(incoming(), reportId) &&
                       incoming().reportId == existing().reportId &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'status', 'adminResolutionNote', 'updatedAt'
                       ]);

      allow delete: if isValidId(reportId) &&
                       (isAdmin() || (isSignedIn() && existing().userId == request.auth.uid));
    }

    // ------------------------------------------------------------------------
    // /grandTests/{testId} — Weekly All-India Grand Tests & Percentile Leaderboard
    // ------------------------------------------------------------------------
    match /grandTests/{testId} {
      allow get: if isSignedIn() && isValidId(testId) &&
                    (isAdmin() || existing().status in ['live', 'closed']);
      allow list: if isAdmin() || (isSignedIn() && resource.data.status in ['live', 'closed']);

      allow create: if isAdmin() &&
                       isValidId(testId) &&
                       isValidGrandTest(incoming(), testId);

      allow update: if isAdmin() &&
                       isValidId(testId) &&
                       isValidGrandTest(incoming(), testId) &&
                       incoming().testId == existing().testId &&
                       incoming().createdAt == existing().createdAt;

      allow delete: if isAdmin() && isValidId(testId);

      match /entries/{userId} {
        allow get: if isSignedIn() && isValidId(testId) && isValidId(userId);
        allow list: if isSignedIn() && isValidId(testId);

        allow create: if isOwner(userId) &&
                         isValidId(testId) &&
                         isValidId(userId) &&
                         isValidGrandTestEntry(incoming(), testId, userId) &&
                         exists(/databases/$(database)/documents/grandTests/$(testId)) &&
                         get(/databases/$(database)/documents/grandTests/$(testId)).data.status == 'live';

        allow update: if false;
        allow delete: if isAdmin() && isValidId(testId) && isValidId(userId);
      }
    }
  }
}
